# Required environment variables for DocuMind

# GEMINI_API_KEY: Required for Gemini AI API calls and embeddings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# MONGODB_URI: Connection string for MongoDB (e.g. mongodb://localhost:27017/documind or MongoDB Atlas URI).
# If omitted or offline, DocuMind uses its robust in-memory persistent adapter.
MONGODB_URI="mongodb://localhost:27017/documind"

# JWT_SECRET: Generate a long random value (for example: `openssl rand -base64 48`).
# This is server-only; do not use a NEXT_PUBLIC_ prefix or commit a real value.
JWT_SECRET="<generate-a-strong-random-secret-here>"

# APP_URL: The base URL where this applet is hosted.
APP_URL="http://localhost:3000"
